# Host of the self-hosted zapple-pay-backend, baked into the bundle at build
# time. A bare host gets https:// prepended; must equal the backend's
# --public-url byte for byte (minus the scheme) or NIP-98 auth fails closed.
# A full origin with scheme is used as-is (local testing: http://127.0.0.1:8081).
VITE_ZAPPLE_API_URL=185-18-221-23.sslip.io
